# ==============================================================================
# Smart Parking Management System (SPMS) - Environment Template
# Copy this file to server/.env and fill in your credentials:
#   cp .env.example server/.env
# ==============================================================================

# PostgreSQL Database Configuration
# Hosted (Neon/Render): set DATABASE_URL and it overrides the DB_* values below
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=spms

# JWT & Authentication Security
JWT_SECRET=spms_jwt_secret_key_2026_dev
JWT_EXPIRES_IN=7d

# QR Code Cryptographic Signing
QR_SECRET=spms_qr_hmac_secret_key_2026_dev

# Server & Network Configuration
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
